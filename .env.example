# Supabase (Project Settings → API). Leave empty to run in on-device demo mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Gemini (https://aistudio.google.com/apikey). Demo only: the key is visible in the browser.
VITE_GEMINI_API_KEY=
VITE_GEMINI_TEXT_MODEL=gemini-2.5-flash
VITE_GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
